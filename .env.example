# URL pública del sitio (para metadata y sitemap)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Contraseña del panel /admin. Sin esto, el panel queda deshabilitado.
ADMIN_PASSWORD=

# Vercel Blob — se completa solo al agregar la integración "Blob" en el
# dashboard de Vercel (Storage). Necesaria para guardar cambios del panel
# y subir imágenes. Sin esto el sitio funciona en modo solo lectura con los
# datos incluidos en el repo (src/data/seed).
BLOB_READ_WRITE_TOKEN=
